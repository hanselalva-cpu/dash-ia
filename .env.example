# Copiar a .env y completar. Nunca commitear .env.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Opcional pero recomendado: la app corre server-side, con secret key no depende de RLS.
# Si queda vacía se usa la publishable, sujeta a RLS (ver supabase/migrations/003_rls.sql).
SUPABASE_SECRET_KEY=

APP_TIMEZONE=America/Mexico_City
# USD o MXN. Solo cambia la visualización: tarifas, costos y presupuestos se guardan en USD.
DEFAULT_DISPLAY_CURRENCY=USD
# Pesos por dólar, obligatorio si DEFAULT_DISPLAY_CURRENCY=MXN. Actualizar a mano.
USD_MXN_RATE=
# true = datos de examples/usage_demo.csv, solo lectura. false = Supabase (requiere URL + key).
DEMO_MODE=false

# Contraseña para entrar al dashboard. Vacía = sin login (solo desarrollo local).
APP_PASSWORD=

# Keys de proveedores para descargar uso/costos.
# ElevenLabs: key normal sirve (python -m integrations.elevenlabs_sync).
# OpenAI: la key de proyecto (sk-proj-) NO puede leer uso → OPENAI_ADMIN_KEY (sk-admin-, la crea un Owner).
# Deepgram: la key necesita scope usage:read (+ keys:read para nombres de keys); rol member no alcanza.
OPENAI_ADMIN_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
